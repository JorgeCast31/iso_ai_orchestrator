# === REQUERIDAS ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === OPCIONALES — se usan si se definen; si no, aplican los defaults indicados ===

# Modelos a usar (defaults: claude-sonnet-4-5-20250929 / gpt-4o)
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# OPENAI_MODEL=gpt-4o

# Control del pipeline (defaults: 4 iteraciones, score >= 90 para stop)
# MAX_ITERATIONS=4
# SCORE_THRESHOLD=90

# Ruta de salida final compatible con integraciones externas (default: outputs/poe_output.txt)
# OUTPUT_FINAL=outputs/poe_output.txt

# Sprint 2B — Plan de mantenimiento Excel (default: deshabilitado)
# INPUT_PLAN_XLSX=inputs/plan_mantenimiento.xlsx
# REQUIRE_PLAN_XLSX=false

# Sprint 3 — Generación DOCX institucional (default: habilitado)
# INPUT_TEMPLATE_DOCX=inputs/plantilla_poe.docx
# OUTPUT_DOCX_ENABLED=true
# OUTPUT_DOCX_FILENAME=final.docx
